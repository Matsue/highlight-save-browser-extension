{
  "manifest_version": 2,
  "name": "Highlight Save to Notion",
  "version": "0.4.0",
  "description": "選択したテキストとページのURLを Notion のデータベースに保存します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "highlight-save-notion@matsuehiroki.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      },
      "update_url": "https://github.com/Matsue/highlight-save-browser-extension/releases/latest/download/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "menus",
    "notifications",
    "<all_urls>",
    "https://api.notion.com/*"
  ],
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/floating-logic.js",
        "content/selection-cache.js",
        "content/floating-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Notionに保存",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "保存ポップアップを開く"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
